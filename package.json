{
  "name": "cloudflare-fleet",
  "version": "0.1.0",
  "private": true,
  "description": "A self-hosted control plane for auditing and safely aligning Cloudflare zones",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/j-256/cloudflare-fleet.git"
  },
  "bugs": {
    "url": "https://github.com/j-256/cloudflare-fleet/issues"
  },
  "keywords": [
    "cloudflare",
    "cloudflare-workers",
    "configuration-management",
    "control-plane",
    "mcp-server"
  ],
  "type": "module",
  "files": [
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs/",
    "fleet-policy.example.json",
    "index.html",
    "launch.sh",
    "migrations/",
    "scripts/build-worker-assets.mjs",
    "scripts/configure-hosted.mjs",
    "scripts/import-hosted-state.mjs",
    "src/",
    "styles.css",
    "wrangler.example.jsonc"
  ],
  "bin": {
    "cloudflare-fleet": "src/cli.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "audit": "node src/cli.mjs audit",
    "build:hosted": "node scripts/build-worker-assets.mjs",
    "check:install": "node scripts/check-install.mjs",
    "check:publication": "node scripts/check-publication.mjs",
    "check:release-tag": "node scripts/check-release-tag.mjs",
    "configure:hosted": "node src/cli.mjs hosted configure",
    "dashboard": "node src/cli.mjs dashboard",
    "db:migrate:local": "wrangler d1 migrations apply cloudflare-fleet --local",
    "db:migrate:remote": "wrangler d1 migrations apply cloudflare-fleet --remote",
    "deploy": "wrangler deploy",
    "docs:serve": "node scripts/serve-docs.mjs",
    "dev:hosted": "wrangler dev",
    "fleet": "node src/cli.mjs",
    "mcp": "node src/cli.mjs mcp",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "screenshots:ci": "node scripts/capture-screenshots.mjs --output test-results/publication-screenshots",
    "state:import:hosted": "node src/cli.mjs hosted import-state",
    "test": "node --test test/*.test.mjs",
    "test:all": "npm test && npm run test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:ergonomics": "playwright test test/e2e/dashboard.ergonomics.spec.mjs --workers=1",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:live:read-only": "CLOUDFLARE_FLEET_RUN_LIVE_READ_ONLY=1 playwright test --config=playwright.live.config.mjs",
    "test:e2e:serve": "node test/e2e/fixture-server.mjs",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@playwright/test": "1.62.1",
    "wrangler": "4.121.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "jose": "6.2.8",
    "zod": "4.4.3"
  }
}
