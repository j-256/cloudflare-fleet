{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-fleet-docs",
  "compatibility_date": "2026-08-11",
  "send_metrics": false,
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./documentation-dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
